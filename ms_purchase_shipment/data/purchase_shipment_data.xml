<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for purchase.shipment -->
        <record id="seq_purchase_shipment" model="ir.sequence">
            <field name="name">Purchase Shipment</field>
            <field name="code">purchase.shipment</field>
            <field name="prefix">SHIP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Cron: Mark overdue shipments -->
        <record id="ir_cron_purchase_shipment_overdue" model="ir.cron" forcecreate="True">
            <field name="name">Purchase Shipment: Mark Overdue</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="model_id" ref="model_purchase_shipment"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_overdue()</field>
        </record>
    </data>
</odoo>
